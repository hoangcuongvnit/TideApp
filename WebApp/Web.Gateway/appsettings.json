{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "route1": {
        "ClusterId": "accountCluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "route2": {
        "ClusterId": "accountCluster",
        "Match": {
          "Path": "/api/adminuser/{**catch-all}"
        }
      },
      "route3": {
        "ClusterId": "accountCluster",
        "Match": {
          "Path": "/api/profile/{**catch-all}"
        }
      },
      "route4": {
        "ClusterId": "accountCluster",
        "Match": {
          "Path": "/api/role/{**catch-all}"
        }
      },
      "route5": {
        "ClusterId": "accountCluster",
        "Match": {
          "Path": "/api/webapp/{**catch-all}"
        }
      },
      "route6": {
        "ClusterId": "accountCluster",
        "Match": {
          "Path": "/api/roles"
        }
      },
      "route7": {
        "ClusterId": "accountCluster",
        "Match": {
          "Path": "/api/user/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "accountCluster": {
        "Destinations": {
          "accountDestination": {
            "Address": "https://host.docker.internal:7197",
            "AllowInvalidCertificate": true
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      }
    }
  }
}